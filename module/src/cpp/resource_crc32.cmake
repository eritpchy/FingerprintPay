find_program(PYTHON3_COMMAND python3 REQUIRED)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RESOURCE_BIN}")
execute_process(
    COMMAND "${PYTHON3_COMMAND}" -c
        "import pathlib, sys, zlib; print(format(zlib.crc32(pathlib.Path(sys.argv[1]).read_bytes()), '08x'))"
        "${RESOURCE_BIN}"
    RESULT_VARIABLE CRC32_RESULT
    OUTPUT_VARIABLE RESOURCE_CRC32
    ERROR_VARIABLE CRC32_ERROR
    OUTPUT_STRIP_TRAILING_WHITESPACE
)
string(LENGTH "${RESOURCE_CRC32}" CRC32_LENGTH)
if(NOT CRC32_RESULT EQUAL 0 OR NOT CRC32_LENGTH EQUAL 8 OR NOT RESOURCE_CRC32 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Cannot calculate resource CRC32: ${CRC32_ERROR}")
endif()
add_definitions(-DRESOURCE_CRC32=0x${RESOURCE_CRC32})
